<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.unitracker</groupId>
    <artifactId>uni-tracker</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Uni Tracker</name>
    <description>Offline multi-skill progress tracker (PoC) - Java/JavaFX/SQLite</description>

    <!--
        NOTE ON VERSIONS: every version below was verified against Maven Central
        at the time this PoC was generated. If a build fails with "dependency
        not found", check https://mvnrepository.com for a newer patch release
        and bump the relevant property - nothing else needs to change.
    -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- VERIFIED: JavaFX 25 is compiled targeting release flag 23 and
             refuses to run on anything older (fails with "javafx.base module
             cannot be read"). JDK 25 is the OpenJFX team's own
             recommendation, so we target it throughout for a clean,
             single-version requirement. -->
        <maven.compiler.release>25</maven.compiler.release>

        <!-- JavaFX 25.0.1 = latest patch of the 25 LTS line (Gluon-recommended
             for production use over the short-lived 26 feature release).
             Needs JDK 23+ minimum, JDK 25 recommended - see setup guide. -->
        <javafx.version>25.0.1</javafx.version>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>

        <sqlite.jdbc.version>3.53.2.0</sqlite.jdbc.version>
        <flexmark.version>0.64.8</flexmark.version>
        <pdfbox.version>3.0.7</pdfbox.version>

        <mainClass>com.unitracker.MainApp</mainClass>
    </properties>

    <dependencies>
        <!-- ===== JavaFX ===== -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- javafx-web powers the WebView used to render Markdown sticky notes -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- javafx-swing provides SwingFXUtils, the bridge used to convert a
             Node.snapshot() into a java.awt.image.BufferedImage so the active
             chart can be embedded as an image in the PDF export. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- javafx-media backs util/SoundPlayer (AudioClip) for UI sound effects.
             It was ALREADY on the classpath transitively via javafx-web's POM, so
             declaring it adds no download - but relying on another artifact's
             transitive graph for a class we import directly is how builds break
             silently later. Note javafx.web does not *require* javafx.media as a
             module, so it must also appear in add-modules below. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- ===== SQLite (fully offline, embedded, zero-config) ===== -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.jdbc.version}</version>
        </dependency>

        <!-- ===== Flexmark (Markdown -> HTML for sticky notes, incl. GFM task lists) ===== -->
        <dependency>
            <groupId>com.vladsch.flexmark</groupId>
            <artifactId>flexmark-all</artifactId>
            <version>${flexmark.version}</version>
        </dependency>

        <!-- ===== PDFBox (PDF export) ===== -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiles the sources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!--
                Runs the app with the correct module-path/add-modules flags
                automatically. This is THE standard fix for the classic
                "Error: JavaFX runtime components are missing" problem that
                happens when JavaFX is launched like a normal jar on JDK 11+.
                Usage: mvn javafx:run  (see the NetBeans setup guide below).
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.maven.plugin.version}</version>
                <configuration>
                    <mainClass>${mainClass}</mainClass>
                    <!-- javafx.web (WebView), javafx.swing (SwingFXUtils, used by
                         PDF export) and javafx.media (AudioClip, used by
                         util/SoundPlayer) all need to be added explicitly - none is
                         a transitive dependency of javafx-controls/-fxml, and optional
                         JavaFX modules aren't auto-included by the plugin's module path.
                         javafx.media in particular is NOT implied by javafx.web:
                         javafx-web's Maven POM depends on javafx-media, but the
                         javafx.web *module* does not require it. Drop it here and
                         SoundPlayer dies with NoClassDefFoundError at runtime. -->
                    <options>
                        <option>--add-modules</option>
                        <option>javafx.web,javafx.swing,javafx.media</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        WINDOWS .EXE PACKAGING (Launch4j)
        Build with: mvn clean package -Pwindows-exe
        Produces:   target/UniTracker.exe  +  target/uni-tracker-windows.jar

        This profile is deliberately separate from the default build so that
        day-to-day development (mvn javafx:run in NetBeans) keeps working
        normally on whatever OS you're developing on. It only activates when
        explicitly requested, and forces Windows-native JavaFX binaries
        (classifier "win") regardless of which OS you build it FROM.
    -->
    <profiles>
        <profile>
            <id>windows-exe</id>

            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-fxml</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-web</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-swing</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
                <!-- Needed here too, and for a different reason than in the main
                     dependency block: this profile pins the Windows-native
                     classifier per module. Without an explicit -win javafx-media,
                     the fat jar would carry the media CLASSES but not the native
                     jfxmedia DLLs, so AudioClip would fail only in the built .exe
                     and work fine under mvn javafx:run - the worst kind of bug. -->
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-media</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                </dependency>
            </dependencies>

            <build>
                <plugins>
                    <!-- STEP A: merge every dependency into one runnable fat-jar -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals><goal>shade</goal></goals>
                                <configuration>
                                    <finalName>uni-tracker-windows</finalName>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <!-- Launcher, not MainApp directly - see Launcher.java's
                                                 own javadoc for why: MainApp extends Application, and
                                                 naming an Application subclass as Main-Class in a
                                                 shaded classpath jar is exactly what triggers "JavaFX
                                                 runtime components are missing" on JDK 11+. -->
                                            <mainClass>com.unitracker.Launcher</mainClass>
                                        </transformer>
                                        <!-- PENTING: sqlite-jdbc registers its driver via
                                             META-INF/services/java.sql.Driver. Without this
                                             transformer, shade overwrites that file with another
                                             dependency's copy and the fat-jar fails at runtime
                                             with "No suitable driver found". -->
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                    </transformers>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>module-info.class</exclude>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- STEP B: wrap the fat-jar into UniTracker.exe -->
                    <plugin>
                        <groupId>com.akathist.maven.plugins.launch4j</groupId>
                        <artifactId>launch4j-maven-plugin</artifactId>
                        <version>2.7.0</version>
                        <executions>
                            <execution>
                                <id>l4j-gui</id>
                                <phase>package</phase>
                                <goals><goal>launch4j</goal></goals>
                                <configuration>
                                    <headerType>gui</headerType>
                                    <outfile>${project.build.directory}/UniTracker.exe</outfile>
                                    <jar>${project.build.directory}/uni-tracker-windows.jar</jar>
                                    <errTitle>Uni Tracker</errTitle>
                                    <classPath>
                                        <mainClass>com.unitracker.Launcher</mainClass>
                                        <addDependencies>false</addDependencies>
                                    </classPath>
                                    <!-- Icon (optional, per your request): commented out ON PURPOSE.
                                         Verified directly against launch4j-maven-plugin's own issue
                                         tracker (orphan-oss/launch4j-maven-plugin#266) - pointing
                                         <icon> at a file that doesn't exist yet is a HARD BUILD
                                         FAILURE ("BuilderException: Icon doesn't exist"), not a
                                         silent fallback to a default icon. Leaving this active before
                                         the file exists would break the very first build.
                                         TO USE: drop a real icon.ico at the project root (next to
                                         this pom.xml), then uncomment the line below exactly as-is.
                                     -->
                                    <icon>${project.basedir}/icon.ico</icon>
                                    
                                    <jre>
                                        <minVersion>25.0.0</minVersion>
                                        <!-- Remove this <path> element if you'd rather require a
                                             system-installed JRE 25+ on the target machine instead
                                             of bundling one - see README.md for both options. -->
                                        <path>jre</path>
                                    </jre>
                                    <versionInfo>
                                        <fileVersion>1.0.0.0</fileVersion>
                                        <txtFileVersion>1.0.0</txtFileVersion>
                                        <fileDescription>UniTracker Multi-Skill Progress Dashboard</fileDescription>
                                        <copyright>UniTracker</copyright>
                                        <productVersion>1.0.0.0</productVersion>
                                        <txtProductVersion>1.0.0</txtProductVersion>
                                        <productName>UniTracker</productName>
                                        <internalName>UniTracker</internalName>
                                        <originalFilename>UniTracker.exe</originalFilename>
                                    </versionInfo>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
